# Настройки патчей Bedolaga.
#
# Этот файл живёт в $BOT_DIR/patches/patches.env — вне git-дерева бота, поэтому
# переживает обновления. `bedolaga_updater patches` создаёт его один раз из
# этого примера и больше никогда не перезаписывает: правьте смело.
#
# После правки перезапустите бота:  cd $BOT_DIR && docker compose up -d
#
# Любую переменную можно временно переопределить через окружение контейнера —
# оно имеет приоритет над этим файлом.

# ------------------------------------------------------------------------------
# Патч: напоминание с инструкцией по подключению
# ------------------------------------------------------------------------------
# Если через N минут после создания подписки человек ни разу не подключился к
# VPN, ему уходит ссылка на инструкцию: в Telegram, а если он регистрировался
# через кабинет и Telegram у него нет — на подтверждённую почту.

PATCH_CONNECT_REMINDER_ENABLED=1

# Через сколько минут после создания подписки проверять подключение.
PATCH_CONNECT_REMINDER_DELAY_MINUTES=10

# Ссылка на инструкцию.
PATCH_CONNECT_REMINDER_URL=https://telegra.ph/Instrukciya-po-podklyucheniyu-INCY-na-Android-05-29

# Как часто проверять (секунды). Минимум 15.
PATCH_CONNECT_REMINDER_INTERVAL_SECONDS=60

# Верхняя граница окна: подписки старше этого возраста уже не догоняем.
# Защита от разовой лавины писем после долгого простоя бота.
PATCH_CONNECT_REMINDER_MAX_AGE_HOURS=24

# Сколько напоминаний максимум за один проход.
PATCH_CONNECT_REMINDER_BATCH=50

# Пауза перед первым проходом после старта бота (секунды) — чтобы не мешать
# alembic-миграциям, которые идут при запуске контейнера.
PATCH_CONNECT_REMINDER_STARTUP_DELAY_SECONDS=90

# user         — одно напоминание на человека за всё время (по умолчанию)
# subscription — по одному на каждую новую подписку
PATCH_CONNECT_REMINDER_ONCE_PER=user

# 0 — не трогать тех, кто подписался ДО установки патча (по умолчанию).
# 1 — при первом запуске разослать и им, в пределах MAX_AGE_HOURS.
PATCH_CONNECT_REMINDER_BACKFILL=0
