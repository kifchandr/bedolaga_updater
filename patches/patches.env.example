# Настройки патчей Bedolaga.
#
# Этот файл живёт в $BOT_DIR/patches/patches.env — вне git-дерева бота, поэтому
# переживает обновления. `bedolaga_updater patches` создаёт его один раз из
# этого примера и больше никогда не перезаписывает: правьте смело.
#
# После правки перезапустите бота:  cd $BOT_DIR && docker compose up -d
#
# Любую переменную можно временно переопределить через окружение контейнера —
# оно имеет приоритет над этим файлом.


# ==============================================================================
# СПИСОК ПАТЧЕЙ: 1 — включён, 0 — выключен. По умолчанию включено всё.
# ==============================================================================

# Напоминание с инструкцией по подключению
PATCH_CONNECT_REMINDER_ENABLED=1

# Отчёт по рефералам для конкурса в админ-панели
PATCH_CONTEST_REPORT_ENABLED=1

# Кнопка магазина внизу главного меню
PATCH_SHOP_BUTTON_ENABLED=1


# ==============================================================================
# Патч: напоминание с инструкцией по подключению
# ==============================================================================
# Если через N минут после создания подписки человек ни разу не подключился к
# VPN, ему уходит ссылка на инструкцию: в Telegram, а если он регистрировался
# через кабинет и Telegram у него нет — на подтверждённую почту.

# Через сколько минут после создания подписки проверять подключение.
PATCH_CONNECT_REMINDER_DELAY_MINUTES=10

# Ссылка на инструкцию.
PATCH_CONNECT_REMINDER_URL=https://telegra.ph/Instrukciya-po-podklyucheniyu-INCY-na-Android-05-29

# Как часто проверять (секунды). Минимум 15.
PATCH_CONNECT_REMINDER_INTERVAL_SECONDS=60

# Верхняя граница окна: подписки старше этого возраста уже не догоняем.
# Защита от разовой лавины писем после долгого простоя бота.
PATCH_CONNECT_REMINDER_MAX_AGE_HOURS=24

# Сколько напоминаний максимум за один проход.
PATCH_CONNECT_REMINDER_BATCH=50

# Пауза перед первым проходом после старта бота (секунды) — чтобы не мешать
# alembic-миграциям, которые идут при запуске контейнера.
PATCH_CONNECT_REMINDER_STARTUP_DELAY_SECONDS=90

# user         — одно напоминание на человека за всё время (по умолчанию)
# subscription — по одному на каждую новую подписку
PATCH_CONNECT_REMINDER_ONCE_PER=user

# 0 — не трогать тех, кто подписался ДО установки патча (по умолчанию).
# 1 — при первом запуске разослать и им, в пределах MAX_AGE_HOURS.
PATCH_CONNECT_REMINDER_BACKFILL=0


# ==============================================================================
# Патч: отчёт по рефералам для конкурса
# ==============================================================================
# Кнопка «🏆 Конкурс рефералов» в админ-панели и команда /contest_report.
# Только читает базу, ничего не меняет.

# Часовой пояс дат и пресетов, в часах от UTC (3 = МСК).
PATCH_CONTEST_REPORT_TZ_OFFSET=3

# Минимальный депозит, засчитываемый как конверсия реферала, ₽.
PATCH_CONTEST_REPORT_MIN_DEPOSIT_RUB=100

# Сколько строк показывать в топе сообщения (полный список — в CSV).
PATCH_CONTEST_REPORT_TOP=20

# period — конверсия засчитывается, если первая покупка попала в период
# all    — если покупка была когда угодно
PATCH_CONTEST_REPORT_SCOPE=period

# Платёжные методы, не считающиеся реальным пополнением (через запятую).
# manual — ручное начисление админом.
PATCH_CONTEST_REPORT_NON_REAL_METHODS=manual

# Подпись кнопки в админ-панели.
PATCH_CONTEST_REPORT_BUTTON_TEXT=🏆 Конкурс рефералов

# Под какой кнопкой админ-меню встать (её callback_data).
# По умолчанию — сразу под «Промокоды/Статистика».
PATCH_CONTEST_REPORT_ANCHOR=admin_submenu_promo

# Сколько последних введённых вручную периодов предлагать кнопками (0 — не хранить).
PATCH_CONTEST_REPORT_RECENT_PERIODS=3

# На сколько секунд кешировать агрегат за период. Смена сортировки, выгрузка CSV
# и билеты берут данные из кеша, а не гоняют запрос заново. 0 — выключить кеш.
PATCH_CONTEST_REPORT_CACHE_SECONDS=120


# ==============================================================================
# Патч: кнопка магазина в главном меню
# ==============================================================================
# Добавляет в главное меню кнопку-ссылку — выше служебных строк «Админ-панель»
# и «Модерация», а у обычного пользователя последней.
# Штатные кастомные кнопки бота (кабинет → главное меню) встают в середину,
# перед промокодом и поддержкой, поэтому нужного места через них не добиться.

# Подпись кнопки.
PATCH_SHOP_BUTTON_TEXT=💰 Наш магазин

# Куда ведёт. Обязательно http:// или https:// — с битой ссылкой Telegram
# отвергает всё сообщение, поэтому такая кнопка просто не рисуется.
PATCH_SHOP_BUTTON_URL=https://ahrishop.com/
