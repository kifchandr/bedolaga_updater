#!/usr/bin/env bash
#
# Selfsteal для ноды Remnawave — настройка со стороны сервера.
# Репозиторий: https://github.com/kifchandr/bedolaga_updater
#
# Запускать НА НОДЕ (там, где крутится контейнер remnanode), не на сервере бота:
#   curl -fsSL https://raw.githubusercontent.com/kifchandr/bedolaga_updater/main/selfsteal | bash -s -- polska.ahriboost.com
#
# Что делает:
#   1. Проверяет окружение: docker, запущенный remnanode, свободный порт 80.
#   2. Сверяет A-запись домена с публичным IP этого сервера.
#   3. Определяет, как сетевой стек у remnanode (host или bridge) — от этого
#      зависит, по какому адресу Xray достучится до сайта-прикрытия.
#   4. Поднимает Caddy с сайтом-заглушкой: публичный :80 (сертификат + редирект)
#      и локальный :9443 (сам сайт, туда смотрит REALITY).
#   5. Проверяет, что сертификат выпущен настоящим УЦ и сайт отдаётся.
#   6. Генерирует ключи x25519 и shortId.
#   7. Печатает готовый блок realitySettings для панели Remnawave.
#
# Чего НЕ делает: не трогает конфиг Xray. Он хранится в панели и раздаётся
# нодам оттуда — вписать туда значения нужно руками (скрипт их печатает).
#
# Аргументы:
#   <домен>                  обязательный, например polska.ahriboost.com
#   --port N                 локальный порт сайта (по умолчанию 9443)
#   --dir /path              куда ставить (по умолчанию /opt/selfsteal)
#   --node-container ИМЯ     имя контейнера ноды (по умолчанию remnanode)
#   --keep-site              не перезаписывать html, если он уже есть
#   -h, --help               справка

set -uo pipefail

# ------------------------------------------------------------------ оформление
if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_RED=$'\033[31m'; C_GRN=$'\033[32m'
  C_YEL=$'\033[33m'; C_BLU=$'\033[36m'; C_BOLD=$'\033[1m'
else
  C_RESET=; C_RED=; C_GRN=; C_YEL=; C_BLU=; C_BOLD=
fi

info()  { echo "${C_BLU}ℹ️  $*${C_RESET}"; }
ok()    { echo "${C_GRN}✅ $*${C_RESET}"; }
warn()  { echo "${C_YEL}⚠️  $*${C_RESET}" >&2; }
err()   { echo "${C_RED}❌ $*${C_RESET}" >&2; }
step()  { echo; echo "${C_BOLD}==============================${C_RESET}";
          echo "${C_BOLD}$*${C_RESET}";
          echo "${C_BOLD}==============================${C_RESET}"; }
die()   { err "$*"; exit 1; }

ask() {
  local prompt="$1" __var="$2" __ans=""
  if [ -r /dev/tty ]; then read -r -p "$prompt" __ans < /dev/tty
  else read -r -p "$prompt" __ans; fi
  printf -v "$__var" '%s' "$__ans"
}
confirm() {
  [ "${NO_CONFIRM:-0}" = "1" ] && return 0
  local def="${2:-y}" hint a=""
  case "$def" in [yY]) hint="[Y/n]";; *) hint="[y/N]";; esac
  ask "$1 $hint: " a
  [ -z "$a" ] && a="$def"
  case "$a" in y*|Y*|д*|Д*) return 0;; *) return 1;; esac
}

# Текст справки держим здесь, а не вычитываем из «$0»: при запуске через
# `curl | bash` скрипт приходит на stdin, файла с таким именем нет.
usage() {
  cat <<'USAGE'
Selfsteal для ноды Remnawave — настройка со стороны сервера.

Запускать НА НОДЕ (там, где крутится контейнер remnanode), не на сервере бота:
  curl -fsSL https://raw.githubusercontent.com/kifchandr/bedolaga_updater/main/selfsteal | bash -s -- polska.ahriboost.com

Что делает:
  1. Проверяет окружение: docker, запущенный remnanode, свободный порт 80.
  2. Сверяет A-запись домена с публичным IP этого сервера.
  3. Определяет сеть remnanode (host или bridge) — от неё зависит, по какому
     адресу Xray достучится до сайта-прикрытия.
  4. Поднимает Caddy с сайтом-заглушкой: публичный :80 (сертификат и редирект)
     и локальный :9443 (сам сайт, туда смотрит REALITY).
  5. Проверяет, что сертификат от настоящего УЦ и сайт отдаётся.
  6. Генерирует ключи x25519 и shortId.
  7. Печатает готовый блок realitySettings для панели Remnawave.

Конфиг Xray скрипт НЕ трогает: он хранится в панели и раздаётся нодам оттуда.
Значения нужно вписать руками — скрипт их печатает.

Аргументы:
  <домен>                обязательный, например polska.ahriboost.com
  --port N               локальный порт сайта (по умолчанию 9443)
  --dir /path            куда ставить (по умолчанию /opt/selfsteal)
  --node-container ИМЯ   имя контейнера ноды (по умолчанию remnanode)
  --keep-site            не перезаписывать html, если он уже есть
  -h, --help             эта справка

Переменные окружения: SELFSTEAL_DOMAIN, SELFSTEAL_PORT, SELFSTEAL_DIR,
NODE_CONTAINER, NO_CONFIRM=1 (не задавать вопросов).
USAGE
}

# ------------------------------------------------------------------- аргументы
DOMAIN="${SELFSTEAL_DOMAIN:-}"
PORT="${SELFSTEAL_PORT:-9443}"
DIR="${SELFSTEAL_DIR:-/opt/selfsteal}"
NODE_CONTAINER="${NODE_CONTAINER:-remnanode}"
KEEP_SITE=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --port)           PORT="${2:-}"; shift 2 ;;
    --dir)            DIR="${2:-}"; shift 2 ;;
    --node-container) NODE_CONTAINER="${2:-}"; shift 2 ;;
    --keep-site)      KEEP_SITE=1; shift ;;
    -h|--help)        usage; exit 0 ;;
    -*)               usage >&2; die "Неизвестный ключ: $1" ;;
    *)                DOMAIN="$1"; shift ;;
  esac
done

[ -n "$DOMAIN" ] || { usage >&2; die "Не указан домен. Пример: bash -s -- polska.ahriboost.com"; }
case "$DOMAIN" in
  *.*) : ;;
  *)   die "«$DOMAIN» не похож на домен." ;;
esac
case "$PORT" in
  ''|*[!0-9]*) die "Порт должен быть числом: $PORT" ;;
esac

step "🕵️  Selfsteal для $DOMAIN"

# ----------------------------------------------------------------- окружение
[ "$(id -u)" = "0" ] || die "Нужны права root."

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "Не найдена команда: $1"; }
need_cmd docker
need_cmd curl

if docker compose version >/dev/null 2>&1; then
  DC() { docker compose "$@"; }
elif command -v docker-compose >/dev/null 2>&1; then
  DC() { docker-compose "$@"; }
else
  die "Не найден docker compose."
fi
docker info >/dev/null 2>&1 || die "Docker недоступен."

if ! docker ps --format '{{.Names}}' | grep -qx "$NODE_CONTAINER"; then
  warn "Контейнер «$NODE_CONTAINER» не запущен."
  docker ps --format '  {{.Names}}\t{{.Image}}' | head -10
  confirm "Продолжить всё равно? Проверить связку Xray→сайт не получится." n \
    || die "Остановлено."
  NODE_CONTAINER=""
else
  ok "Нода найдена: $NODE_CONTAINER"
fi

# ------------------------------------------------- куда Xray будет стучаться
# Xray живёт ВНУТРИ контейнера ноды. Если у контейнера сеть host, его 127.0.0.1
# — это петля самого сервера, и Caddy на 127.0.0.1 доступен. А если сеть
# bridge, то 127.0.0.1 внутри — петля контейнера, и сайт по нему не найдётся:
# достучаться можно только через адрес шлюза docker-сети. Это самая частая
# причина, почему selfsteal «настроен, но не работает».
XRAY_TARGET_HOST="127.0.0.1"
CADDY_BIND="127.0.0.1"
NET_MODE=""

if [ -n "$NODE_CONTAINER" ]; then
  NET_MODE=$(docker inspect -f '{{.HostConfig.NetworkMode}}' "$NODE_CONTAINER" 2>/dev/null)
  if [ "$NET_MODE" = "host" ]; then
    ok "Сеть ноды: host → Xray достучится по 127.0.0.1"
  else
    GW=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.Gateway}} {{end}}' "$NODE_CONTAINER" 2>/dev/null | awk '{print $1}')
    if [ -n "$GW" ]; then
      XRAY_TARGET_HOST="$GW"
      CADDY_BIND="127.0.0.1 $GW"
      warn "Сеть ноды: $NET_MODE (не host)."
      info "Xray будет стучаться на шлюз docker-сети: $GW"
    else
      warn "Сеть ноды «$NET_MODE», но шлюз определить не удалось."
      warn "Оставляю 127.0.0.1 — если связка не заработает, смотрите сюда."
    fi
  fi
fi

# ---------------------------------------------------------------------- DNS
step "🌐 Проверки перед установкой"

PUBLIC_IP=$(curl -4 -fsS --max-time 10 https://api.ipify.org 2>/dev/null \
            || curl -4 -fsS --max-time 10 https://ifconfig.me 2>/dev/null)
DOMAIN_IP=$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk 'NR==1{print $1}')

info "Публичный IP сервера: ${PUBLIC_IP:-не определён}"
info "A-запись $DOMAIN:     ${DOMAIN_IP:-не резолвится}"

if [ -z "$DOMAIN_IP" ]; then
  warn "Домен не резолвится. Сертификат Let's Encrypt выпустить не выйдет."
  confirm "Продолжить?" n || die "Остановлено."
elif [ -n "$PUBLIC_IP" ] && [ "$DOMAIN_IP" != "$PUBLIC_IP" ]; then
  warn "Домен указывает на $DOMAIN_IP, а сервер имеет $PUBLIC_IP."
  warn "Если это не проксирование (например, оранжевое облако Cloudflare) —"
  warn "выпуск сертификата не пройдёт, а REALITY будет прикрываться чужим IP."
  confirm "Продолжить?" n || die "Остановлено."
else
  ok "Домен указывает на этот сервер."
fi

# --------------------------------------------------------------------- порты
port_busy() {  # port_busy ПОРТ → печатает, кто занял
  if command -v ss >/dev/null 2>&1; then
    ss -lntp "sport = :$1" 2>/dev/null | awk 'NR>1'
  elif command -v netstat >/dev/null 2>&1; then
    netstat -lntp 2>/dev/null | awk -v p=":$1\$" '$4 ~ p'
  fi
}

BUSY80="$(port_busy 80)"
if [ -n "$BUSY80" ]; then
  warn "Порт 80 занят — он нужен Caddy для выпуска сертификата:"
  echo "$BUSY80" | sed 's/^/   /'
  confirm "Продолжить? Сертификат, скорее всего, не выпустится." n || die "Остановлено."
else
  ok "Порт 80 свободен."
fi

BUSY443="$(port_busy 443)"
if [ -z "$BUSY443" ]; then
  warn "Порт 443 никем не занят — а его должен слушать Xray."
  warn "Проверьте, что инбаунд ноды поднят, иначе прикрывать будет нечего."
else
  ok "Порт 443 занят (ожидаемо — это Xray)."
fi

BUSYP="$(port_busy "$PORT")"
if [ -n "$BUSYP" ]; then
  warn "Порт $PORT уже занят:"
  echo "$BUSYP" | sed 's/^/   /'
  confirm "Продолжить? Caddy может не подняться." n || die "Остановлено."
fi

# ------------------------------------------------------------------ установка
step "📦 Ставлю сайт-прикрытие в $DIR"

mkdir -p "$DIR/html" || die "Не удалось создать $DIR"

# Caddyfile.
#   * https_port — сайт слушает НЕ публичный 443 (его занял Xray), а локальный.
#   * bind — только петля (и шлюз docker, если нода в bridge). Наружу порт
#     сайта не выставляем: сайт виден только через REALITY.
#   * auto_https disable_redirects — свой редирект пишем руками. Автоматический
#     Caddy увёл бы на https://домен:9443, куда снаружи не попасть.
cat > "$DIR/Caddyfile" <<CADDY
{
	https_port $PORT
	auto_https disable_redirects
	admin off
}

http://$DOMAIN {
	redir https://{host}{uri} permanent
}

https://$DOMAIN {
	bind $CADDY_BIND
	root * /srv/html
	file_server
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
CADDY
ok "Caddyfile записан."

cat > "$DIR/docker-compose.yml" <<'COMPOSE'
# Сеть host обязательна: сайт должен быть виден по петле сервера, а порт 80
# — публично, иначе Let's Encrypt не пройдёт проверку.
services:
  caddy:
    image: caddy:2-alpine
    container_name: selfsteal_caddy
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ./html:/srv/html:ro
      - caddy_data:/data
      - caddy_config:/config

volumes:
  caddy_data:
  caddy_config:
COMPOSE
ok "docker-compose.yml записан."

if [ -f "$DIR/html/index.html" ] && [ "$KEEP_SITE" = "1" ]; then
  info "Страница уже есть, оставляю (--keep-site)."
else
  cat > "$DIR/html/index.html" <<HTML
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$DOMAIN</title>
<style>
  :root { color-scheme: light dark; }
  body {
    margin: 0; min-height: 100vh; display: grid; place-items: center;
    font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: #f6f7f9; color: #1f2328;
  }
  @media (prefers-color-scheme: dark) {
    body { background: #14161a; color: #e6e8eb; }
    .card { background: #1c1f24 !important; border-color: #2a2f37 !important; }
    .muted { color: #9aa4b2 !important; }
  }
  .card {
    background: #fff; border: 1px solid #e3e6ea; border-radius: 14px;
    padding: 40px 44px; max-width: 520px; margin: 24px;
  }
  h1 { margin: 0 0 12px; font-size: 22px; font-weight: 600; }
  p { margin: 0 0 10px; }
  .muted { color: #6b7280; font-size: 14px; }
  code { font-size: 13px; }
</style>
</head>
<body>
  <main class="card">
    <h1>$DOMAIN</h1>
    <p>Сервер работает. Публичного содержимого здесь пока нет.</p>
    <p class="muted">Если вы попали сюда по ошибке — просто закройте страницу.</p>
  </main>
</body>
</html>
HTML
  ok "Страница-заглушка создана."
fi

cat > "$DIR/html/robots.txt" <<'ROBOTS'
User-agent: *
Disallow:
ROBOTS

step "🚀 Запускаю Caddy"
( cd "$DIR" && DC up -d ) || die "Не удалось запустить Caddy."

info "Жду выпуска сертификата (до 90 секунд)..."
CERT_OK=0
for i in $(seq 1 30); do
  if curl -sS --max-time 5 --resolve "$DOMAIN:$PORT:127.0.0.1" \
        "https://$DOMAIN:$PORT/" -o /dev/null 2>/dev/null; then
    CERT_OK=1
    break
  fi
  sleep 3
  printf '\r  ...%ss   ' "$((i * 3))"
done
echo

# ------------------------------------------------------------------ проверки
step "🔍 Проверяю результат"

SITE_OK=0
if curl -sS --max-time 8 --resolve "$DOMAIN:$PORT:127.0.0.1" "https://$DOMAIN:$PORT/" \
     2>/dev/null | grep -q "$DOMAIN"; then
  ok "Сайт отдаётся по https://$DOMAIN:$PORT (локально)."
  SITE_OK=1
else
  err "Сайт по локальному адресу не отвечает."
  ( cd "$DIR" && DC logs --tail 25 ) 2>&1 | sed 's/^/   /'
fi

ISSUER=$(echo | openssl s_client -connect "127.0.0.1:$PORT" -servername "$DOMAIN" 2>/dev/null \
         | openssl x509 -noout -issuer 2>/dev/null)
if [ -n "$ISSUER" ]; then
  echo "   Сертификат: $ISSUER"
  case "$ISSUER" in
    *"Let's Encrypt"*|*"ZeroSSL"*|*"Google Trust"*)
      ok "Сертификат от настоящего УЦ — зонд увидит обычный сайт." ;;
    *"Caddy Local"*|*"local"*)
      warn "Сертификат САМОПОДПИСАННЫЙ (Caddy internal)."
      warn "Значит, выпуск через Let's Encrypt не прошёл — обычно из-за порта 80."
      warn "Selfsteal будет работать, но зонд увидит самоподписанный сертификат"
      warn "на домене с настоящим DNS — это заметная аномалия." ;;
    *)
      info "Проверьте издателя глазами — ожидается публичный УЦ." ;;
  esac
else
  warn "Не удалось прочитать сертификат (нет openssl?)."
fi

# Главная проверка: видит ли САМ Xray сайт по тому адресу, который мы пропишем.
if [ -n "$NODE_CONTAINER" ]; then
  REACH=""
  for probe in \
    "curl -sS --max-time 5 -k https://$XRAY_TARGET_HOST:$PORT/ -o /dev/null" \
    "wget -q -T 5 --no-check-certificate -O /dev/null https://$XRAY_TARGET_HOST:$PORT/" \
    "nc -z -w 3 $XRAY_TARGET_HOST $PORT"
  do
    if docker exec "$NODE_CONTAINER" sh -c "$probe" >/dev/null 2>&1; then
      REACH="ok"; break
    fi
  done
  if [ "$REACH" = "ok" ]; then
    ok "Изнутри ноды сайт доступен по $XRAY_TARGET_HOST:$PORT — связка сойдётся."
  else
    warn "Изнутри контейнера «$NODE_CONTAINER» проверить доступность не вышло."
    warn "Это может быть и отсутствие curl/wget/nc в образе, и реальная проблема сети."
    warn "Если после правки конфига REALITY не заработает — причина, скорее всего, здесь."
  fi
fi

# ------------------------------------------------------------------ ключи
step "🔑 Ключи для REALITY"

KEYS=""
if [ -n "$NODE_CONTAINER" ]; then
  KEYS=$(docker exec "$NODE_CONTAINER" xray x25519 2>/dev/null)
fi
if [ -z "$KEYS" ]; then
  info "Генерирую разовым контейнером xray-core..."
  KEYS=$(docker run --rm ghcr.io/xtls/xray-core:latest x25519 2>/dev/null)
fi

# Формат вывода `xray x25519` менялся. Было:
#     Private key: ...   /   Public key: ...
# Стало (с 25.3.6):
#     PrivateKey: ...    /   Password: ...    /   Hash32: ...
# «Password» — это тот же публичный ключ, его просто переименовали, чтобы
# реже раздавали кому попало. Разбираем оба варианта.
PRIV=$(echo "$KEYS" | awk -F': *' '/^ *[Pp]rivate ?[Kk]ey/ {print $2; exit}' | tr -d '[:space:]')
PUB=$(echo "$KEYS"  | awk -F': *' '/^ *[Pp]ublic ?[Kk]ey/  {print $2; exit}' | tr -d '[:space:]')
[ -n "$PUB" ] || PUB=$(echo "$KEYS" | awk -F': *' '/^ *[Pp]assword/ {print $2; exit}' | tr -d '[:space:]')
SHORT_ID=$(openssl rand -hex 8 2>/dev/null || head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')

if [ -z "$PRIV" ] || [ -z "$PUB" ]; then
  warn "Не удалось сгенерировать ключи автоматически."
  warn "Сделайте вручную:  docker exec $NODE_CONTAINER xray x25519"
  PRIV="<privateKey>"; PUB="<publicKey>"
else
  ok "Пара ключей сгенерирована."
fi

# ------------------------------------------------------------------ итог
step "📋 Что вписать в панель Remnawave"

cat <<OUT

${C_BOLD}1) Конфиг Xray → инбаунд POLAND_SELFSTEAL → realitySettings:${C_RESET}

    "realitySettings": {
      "show": false,
      "xver": 0,
      "target": "$XRAY_TARGET_HOST:$PORT",
      "shortIds": ["$SHORT_ID"],
      "privateKey": "$PRIV",
      "fingerprint": "chrome",
      "serverNames": ["$DOMAIN"],
      "minClientVer": "0.0.0"
    }

${C_BOLD}2) Hosts → хост этого инбаунда:${C_RESET}

    Address    : $DOMAIN
    Port       : 443
    SNI        : $DOMAIN
    Public key : $PUB
    Short ID   : $SHORT_ID
    Fingerprint: chrome
    Flow       : xtls-rprx-vision

${C_BOLD}3) Сохранить конфиг в панели и дождаться применения на ноде.${C_RESET}

OUT

warn "Старый privateKey больше не используйте: он засветился в переписке."
info "Файлы сайта: $DIR   ·   логи: cd $DIR && docker compose logs -f"
info "Проверить сайт снаружи после правки конфига: curl -I https://$DOMAIN"

if [ "$SITE_OK" = "1" ]; then
  ok "Серверная часть готова. Осталось вписать значения в панель."
else
  err "Серверная часть поднялась не полностью — сначала разберитесь с Caddy."
  exit 1
fi
