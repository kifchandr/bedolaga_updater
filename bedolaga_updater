#!/usr/bin/env bash
#
# Bedolaga Bot — поэтапное обновление (staged upgrade)
# Репозиторий: https://github.com/BEDOLAGA-DEV/remnawave-bedolaga-telegram-bot
#
# Запуск прямо с GitHub (после того как зальёте скрипт в свой репозиторий/gist):
#   curl -fsSL https://raw.githubusercontent.com/kifchandr/bedolaga_updater/main/bedolaga_updater | bash
#
# Что делает:
#   1. Сам находит папку бота (по label запущенного контейнера remnawave_bot или по CWD).
#   2. Определяет текущую версию (из .release-please-manifest.json / pyproject / git-тега).
#   3. Проверяет свободное место на диске перед стартом.
#   4. Делает бэкап БД (pg_dump -Fc) перед каждой устанавливаемой версией.
#   5. Поэтапно (тег за тегом): сначала собирает образ, не трогая работающие
#      контейнеры, и только потом перезапускает стек и ждёт healthcheck.
#   6. Переустанавливает патчи (наши правки поведения бота), если они стоят.
#   7. Если рядом с ботом есть папка cabinet и бот доведён до последней версии — обновляет её.
#   8. Чистит неиспользуемые docker-образы и показывает, как смотреть логи.
#
# Команды:
#   bedolaga_updater            — меню: обновить бота / управлять патчами
#   bedolaga_updater update     — сразу обновление, без меню
#   bedolaga_updater patches    — сразу меню патчей
#   bedolaga_updater --help     — справка
#
# Без аргументов скрипт показывает меню из двух пунктов. Если запуск
# неинтерактивный (cron, NO_CONFIRM=1), меню пропускается и идёт обновление.
#
# Через curl аргументы передаются так:
#   curl -fsSL .../bedolaga_updater | bash -s -- patches
#
# Что такое патчи:
#   Правки поведения бота, которых нет в апстриме. Живут в $BOT_DIR/patches/ и
#   подключаются через $BOT_DIR/docker-compose.override.yml. Оба пути git
#   игнорирует, поэтому `git checkout <тег>` при обновлении их не затирает —
#   в отличие от прямых правок в файлах бота, которые обновление сносит.
#
# Переменные окружения (все опциональны):
#   BOT_DIR=/path/to/bot     — принудительно указать папку бота
#   CABINET_DIR=/path         — принудительно указать папку кабинета
#   TARGET_VERSION=3.60.0     — обновляться не до последней, а до конкретной версии
#   PG_USER / PG_DB / PG_CONTAINER — переопределить параметры БД
#   BACKUP_RETENTION=10       — сколько последних бэкапов хранить (0 = не чистить)
#   BACKUP_EVERY=1            — бэкап перед каждой N-й версией (1 = перед каждой, 0 = только один в начале)
#   MIN_FREE_MB=3000         — минимум свободного места (МБ), иначе стоп
#   PRUNE_IMAGES=1           — чистить неиспользуемые образы в конце (0 = не чистить)
#   NO_CONFIRM=1              — не спрашивать подтверждение
#   SKIP_BACKUP=1            — пропустить бэкапы (НЕ рекомендуется)
#   DRY_RUN=1                — только показать план, ничего не менять
#   PATCHES=auto|1|0         — переустанавливать ли патчи после обновления
#                              (auto = только если уже установлены)
#   PATCHES_BASE_URL=...     — откуда качать файлы патчей
#   PLAIN_MENU=1             — меню без стрелок, ввод номера пункта
#                              (включается само, если терминала нет)

set -uo pipefail

# ------------------------------------------------------------------ оформление
if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_RED=$'\033[31m'; C_GRN=$'\033[32m'
  C_YEL=$'\033[33m'; C_BLU=$'\033[36m'; C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'; C_SEL=$'\033[1;97;44m'   # выбранный пункт меню: белым по синему
  C_HIDE=$'\033[?25l'; C_SHOW=$'\033[?25h'   # курсор во время рисования меню
else
  C_RESET=; C_RED=; C_GRN=; C_YEL=; C_BLU=; C_BOLD=
  C_DIM=; C_SEL=; C_HIDE=; C_SHOW=
fi

# Прерывание в момент, когда курсор спрятан, оставило бы его невидимым до конца
# сессии — возвращаем его на любом выходе.
trap 'printf "%s" "$C_SHOW"' EXIT

info()  { echo "${C_BLU}ℹ️  $*${C_RESET}"; }
ok()    { echo "${C_GRN}✅ $*${C_RESET}"; }
warn()  { echo "${C_YEL}⚠️  $*${C_RESET}" >&2; }
err()   { echo "${C_RED}❌ $*${C_RESET}" >&2; }
step()  { echo; echo "${C_BOLD}==============================${C_RESET}";
          echo "${C_BOLD}$*${C_RESET}";
          echo "${C_BOLD}==============================${C_RESET}"; }
die()   { err "$*"; exit 1; }

# Чтение ввода даже когда скрипт запущен через `curl | bash` (stdin занят пайпом)
ask() {  # ask "Вопрос: " VARNAME
  local prompt="$1" __var="$2" __ans=""
  if [ -r /dev/tty ]; then read -r -p "$prompt" __ans < /dev/tty
  else read -r -p "$prompt" __ans; fi
  printf -v "$__var" '%s' "$__ans"
}
confirm() {  # confirm "Продолжить?" [default: y]
  [ "${NO_CONFIRM:-0}" = "1" ] && return 0
  local def="${2:-y}" hint a=""
  case "$def" in [yY]) hint="[Y/n]";; *) hint="[y/N]";; esac
  ask "$1 $hint: " a
  # Пустой ввод (просто Enter) = вариант по умолчанию.
  [ -z "$a" ] && a="$def"
  # Классы вида [yYдД] в C-локали сравниваются побайтно, и любой ответ,
  # начинающийся с кириллицы, попадал в "да". Сверяем префиксы целиком.
  case "$a" in y*|Y*|д*|Д*) return 0;; *) return 1;; esac
}

# Меню с выбором стрелками.  pick RESULT_VAR "пункт" "пункт" ...
#   ↑/↓ (или k/j) — перебор, Enter — выбрать, цифра — сразу нужный пункт,
#   q/Esc — отмена. В RESULT_VAR кладётся номер пункта начиная с 1,
#   при отмене — пустая строка.
#
# Перерисовка идёт от запомненной позиции курсора с очисткой всего ниже, а не
# «подняться на N строк»: длинный пункт переносится на вторую строку, и счёт
# строк разъехался бы.  Место под меню резервируется заранее, чтобы прокрутка
# терминала случилась до того, как позиция запомнена.
pick() {
  local __var="$1"; shift
  local items=("$@") n=$# cur=0 key rest i

  printf -v "$__var" '%s' ''
  [ "$n" -gt 0 ] || return 0

  # Нет терминала (cron, пайп без tty) — спрашиваем номер, как раньше.
  if [ ! -r /dev/tty ] || [ ! -t 1 ] || [ "${PLAIN_MENU:-0}" = "1" ]; then
    local ans="" idx=1
    for i in "${items[@]}"; do echo "  $idx) $i"; idx=$((idx+1)); done
    echo
    ask "Выберите пункт [1-$n]: " ans
    printf -v "$__var" '%s' "$ans"
    return 0
  fi

  for ((i = 0; i < n; i++)); do echo; done
  printf '\033[%dA\033[s%s' "$n" "$C_HIDE"

  while :; do
    printf '\033[u\033[J'
    for ((i = 0; i < n; i++)); do
      if [ "$i" = "$cur" ]; then
        printf '  %s ❯ %s %s\n' "$C_SEL" "${items[$i]}" "$C_RESET"
      else
        printf '    %s%s%s\n' "$C_DIM" "${items[$i]}" "$C_RESET"
      fi
    done

    IFS= read -rsn1 key < /dev/tty || { printf '%s' "$C_SHOW"; return 0; }
    case "$key" in
      $'\e')
        rest=""
        IFS= read -rsn2 -t 0.1 rest < /dev/tty
        case "$rest" in
          '[A'|'OA') cur=$(( (cur - 1 + n) % n )) ;;
          '[B'|'OB') cur=$(( (cur + 1) % n )) ;;
          '')        printf '%s' "$C_SHOW"; return 0 ;;   # одиночный Esc — отмена
        esac
        ;;
      '')  printf '%s' "$C_SHOW"; printf -v "$__var" '%s' "$((cur + 1))"; return 0 ;;
      [1-9])
        if [ "$key" -le "$n" ]; then
          printf '%s' "$C_SHOW"; printf -v "$__var" '%s' "$key"; return 0
        fi
        ;;
      k|K) cur=$(( (cur - 1 + n) % n )) ;;
      j|J) cur=$(( (cur + 1) % n )) ;;
      q|Q) printf '%s' "$C_SHOW"; return 0 ;;
    esac
  done
}

# ------------------------------------------------------------------- аргументы
# MODE=menu    — спросить, что делать (по умолчанию, если команду не назвали)
# MODE=update  — сразу обновление (в конце патчи переустанавливаются, если стоят)
# MODE=patches — только работа с патчами, бота не обновляем
MODE="menu"
PATCHES="${PATCHES:-auto}"   # auto | 1 | 0

usage() {
  cat <<'USAGE'
Использование: bedolaga_updater [команда] [ключи]

Команды:
  (без команды)   Показать меню: обновить бота или управлять патчами.
                  В неинтерактивном запуске (cron, NO_CONFIRM=1) меню
                  пропускается и сразу идёт обновление.
  update          Сразу обновить бота, без меню.
  patches         Сразу открыть меню патчей: установить/обновить,
                  включить/выключить, статус, удалить. Бота не обновляем.

Ключи:
  --no-patches    Не трогать патчи после обновления.
  --patches       Переустановить патчи после обновления, даже если раньше их не было.
  -h, --help      Эта справка.

Через curl:
  curl -fsSL https://raw.githubusercontent.com/kifchandr/bedolaga_updater/main/bedolaga_updater | bash
  curl -fsSL https://raw.githubusercontent.com/kifchandr/bedolaga_updater/main/bedolaga_updater | bash -s -- patches
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    patches|patch)  MODE="patches" ;;
    update)         MODE="update" ;;
    --no-patches)   PATCHES="0" ;;
    --patches)      PATCHES="1" ;;
    -h|--help)      usage; exit 0 ;;
    *)              usage >&2; die "Неизвестный аргумент: $1" ;;
  esac
  shift
done

# ------------------------------------------------------------------ окружение
DRY_RUN="${DRY_RUN:-0}"
SKIP_BACKUP="${SKIP_BACKUP:-0}"
BACKUP_RETENTION="${BACKUP_RETENTION:-10}"
BACKUP_EVERY="${BACKUP_EVERY:-1}"      # бэкап перед каждой N-й версией (1 = перед каждой)
MIN_FREE_MB="${MIN_FREE_MB:-3000}"     # минимум свободного места (МБ) для старта
PRUNE_IMAGES="${PRUNE_IMAGES:-1}"      # чистить неиспользуемые образы в конце

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "Не найдена команда: $1"; }
need_cmd git
need_cmd docker

# docker compose v2 или docker-compose v1
if docker compose version >/dev/null 2>&1; then
  DC() { docker compose "$@"; }
elif command -v docker-compose >/dev/null 2>&1; then
  DC() { docker-compose "$@"; }
else
  die "Не найден docker compose (ни 'docker compose', ни 'docker-compose')"
fi

docker info >/dev/null 2>&1 || die "Docker недоступен. Запустите скрипт от root или добавьте пользователя в группу docker."

BOT_CONTAINER="remnawave_bot"

# ------------------------------------------------------------ поиск папки бота
detect_bot_dir() {
  # 1) Явно задано
  if [ -n "${BOT_DIR:-}" ]; then echo "$BOT_DIR"; return; fi
  # 2) По label запущенного контейнера (самый надёжный способ)
  local d
  d=$(docker inspect -f '{{ index .Config.Labels "com.docker.compose.project.working_dir" }}' \
        "$BOT_CONTAINER" 2>/dev/null)
  if [ -n "$d" ] && [ -d "$d" ]; then echo "$d"; return; fi
  # 3) Текущая директория, если похожа на бота
  if [ -f "./docker-compose.yml" ] && [ -d "./.git" ]; then echo "$PWD"; return; fi
  # 4) Спросить
  local ans=""
  warn "Не удалось автоматически определить папку бота."
  ask "Укажите полный путь к папке бота: " ans
  echo "$ans"
}

BOT_DIR="$(detect_bot_dir)"
[ -d "$BOT_DIR" ] || die "Папка бота не найдена: $BOT_DIR"
BOT_DIR="$(cd "$BOT_DIR" && pwd)"
[ -d "$BOT_DIR/.git" ] || die "В $BOT_DIR нет git-репозитория — поэтапное обновление невозможно."
info "Папка бота: ${C_BOLD}$BOT_DIR${C_RESET}"

cd "$BOT_DIR" || die "Не удалось перейти в $BOT_DIR"
# git иногда ругается на 'dubious ownership', когда владелец каталога отличается
git config --global --add safe.directory "$BOT_DIR" 2>/dev/null || true

ENV_FILE="$BOT_DIR/.env"
get_env() {  # get_env KEY DEFAULT
  local v=""
  [ -f "$ENV_FILE" ] && v=$(grep -E "^[[:space:]]*$1[[:space:]]*=" "$ENV_FILE" \
        | tail -n1 | sed -E "s/^[[:space:]]*$1[[:space:]]*=//; s/^['\"]//; s/['\"][[:space:]]*$//")
  echo "${v:-$2}"
}

# --------------------------------------------------------------------- версии
# В сравнениях используем только стабильные релизы (vX.Y.Z без rc/beta-суффиксов).
norm() { echo "${1#v}"; }  # убрать префикс v

current_version() {
  local v=""
  if [ -f "$BOT_DIR/.release-please-manifest.json" ]; then
    v=$(grep -oE '"[0-9]+\.[0-9]+\.[0-9]+"' "$BOT_DIR/.release-please-manifest.json" | head -n1 | tr -d '"')
  fi
  if [ -z "$v" ] && [ -f "$BOT_DIR/pyproject.toml" ]; then
    v=$(grep -E '^version[[:space:]]*=' "$BOT_DIR/pyproject.toml" | head -n1 \
        | sed -E 's/.*=[[:space:]]*["'\'']([0-9.]+)["'\''].*/\1/')
  fi
  if [ -z "$v" ]; then
    v=$(git describe --tags --abbrev=0 2>/dev/null | sed -E 's/^v//; s/-.*//')
  fi
  echo "$v"
}

# Реальный git-ref для тега (учитываем префикс v или его отсутствие)
tag_ref() {
  local t; t="$(norm "$1")"
  if git rev-parse -q --verify "refs/tags/v$t" >/dev/null; then echo "v$t"; return; fi
  if git rev-parse -q --verify "refs/tags/$t"  >/dev/null; then echo "$t";  return; fi
  echo ""
}

# ----------------------------------------------------------------- параметры БД
detect_db() {
  PG_USER="${PG_USER:-$(get_env POSTGRES_USER remnawave_user)}"
  PG_DB="${PG_DB:-$(get_env POSTGRES_DB remnawave_bot)}"
  PG_CONTAINER="${PG_CONTAINER:-remnawave_bot_db}"

  # Если стандартный контейнер не запущен — попробуем найти по compose-проекту
  if ! docker ps --format '{{.Names}}' | grep -qx "$PG_CONTAINER"; then
    local proj found
    proj=$(docker inspect -f '{{ index .Config.Labels "com.docker.compose.project" }}' "$BOT_CONTAINER" 2>/dev/null)
    if [ -n "$proj" ]; then
      found=$(docker ps --filter "label=com.docker.compose.project=$proj" \
                        --filter "label=com.docker.compose.service=postgres" \
                        --format '{{.Names}}' | head -n1)
      [ -n "$found" ] && PG_CONTAINER="$found"
    fi
  fi
}

db_ok() {  # проверяем, что коннект и роль/БД валидны
  docker exec "$PG_CONTAINER" psql -U "$PG_USER" -d "$PG_DB" -tAc 'SELECT 1' >/dev/null 2>&1
}

ensure_db() {
  detect_db
  local tries=0
  while ! db_ok; do
    tries=$((tries+1))
    warn "Не удалось подключиться к БД: контейнер='$PG_CONTAINER' user='$PG_USER' db='$PG_DB'."
    if [ "$tries" -gt 3 ]; then
      die "БД так и не доступна. Проверьте, что контейнер запущен, и параметры в .env."
    fi
    info "Контейнеры с PostgreSQL:"
    docker ps --format '  {{.Names}}\t{{.Image}}' | grep -iE 'postgres|_db' || echo "  (не найдено)"
    ask "  Имя контейнера БД [$PG_CONTAINER]: " _c; [ -n "${_c:-}" ] && PG_CONTAINER="$_c"
    ask "  Пользователь PostgreSQL [$PG_USER]: " _u; [ -n "${_u:-}" ] && PG_USER="$_u"
    ask "  База данных [$PG_DB]: "               _d; [ -n "${_d:-}" ] && PG_DB="$_d"
  done
  ok "БД доступна: контейнер='$PG_CONTAINER' user='$PG_USER' db='$PG_DB'"
}

# --------------------------------------------------------- проверка места на ФС
check_disk() {  # check_disk [min_mb]
  local min="${1:-$MIN_FREE_MB}" avail avail_mb
  avail=$(df -Pk "$BOT_DIR" 2>/dev/null | awk 'NR==2{print $4}')
  if [ -z "$avail" ]; then warn "Не удалось определить свободное место — пропускаю проверку."; return 0; fi
  avail_mb=$(( avail / 1024 ))
  if [ "$avail_mb" -lt "$min" ]; then
    err "Мало места на диске: доступно ${avail_mb} МБ, нужно минимум ${min} МБ."
    err "Освободите место: 'docker system prune -af', удалите старые бэкапы/логи."
    confirm "Продолжить несмотря на нехватку места?" || die "Остановлено из-за нехватки места на диске."
  else
    info "Свободно на диске: ${avail_mb} МБ (порог ${min} МБ) — ок."
  fi
}

# ------------------------------------------------------------------- бэкап БД
BACKUP_DIR="$BOT_DIR/backup"

make_backup() {  # make_backup <метка>
  [ "$SKIP_BACKUP" = "1" ] && { warn "SKIP_BACKUP=1 — бэкап пропущен."; return 0; }
  mkdir -p "$BACKUP_DIR"
  local label="${1:-manual}" file
  file="$BACKUP_DIR/backup_$(date +%Y%m%d_%H%M%S)_${label}.dump"
  info "Бэкап БД → ${file#$BOT_DIR/}"
  if [ "$DRY_RUN" = "1" ]; then echo "  [dry-run] pg_dump пропущен"; return 0; fi
  if docker exec "$PG_CONTAINER" pg_dump -Fc -U "$PG_USER" "$PG_DB" > "$file" 2>/tmp/pgdump.err; then
    local sz; sz=$(du -h "$file" 2>/dev/null | cut -f1)
    ok "Бэкап готов (${sz:-?})"
  else
    err "pg_dump завершился с ошибкой:"; cat /tmp/pgdump.err >&2
    rm -f "$file"
    die "Бэкап не создан — обновление остановлено ради безопасности данных."
  fi
  # Ротация старых бэкапов. Дампы с меткой _keep не трогаем: это состояние
  # "до обновления", самое ценное для отката. Бэкап делается перед каждой
  # версией, поэтому на длинной цепочке обычная ротация съела бы именно его.
  if [ "${BACKUP_RETENTION:-0}" -gt 0 ]; then
    ls -1t "$BACKUP_DIR"/backup_*.dump 2>/dev/null | grep -v '_keep\.dump$' \
      | tail -n +$((BACKUP_RETENTION+1)) | xargs -r rm -f
  fi
}

# -------------------------------------------------------- ожидание готовности
wait_healthy() {
  local timeout="${1:-240}" waited=0 state health
  info "Ожидаю готовности контейнера $BOT_CONTAINER (миграции могут занять время)..."
  while [ "$waited" -lt "$timeout" ]; do
    state=$(docker inspect -f '{{.State.Status}}' "$BOT_CONTAINER" 2>/dev/null || echo "missing")
    health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$BOT_CONTAINER" 2>/dev/null || echo none)
    case "$state" in
      running)
        if [ "$health" = "healthy" ]; then ok "Контейнер healthy."; return 0; fi
        if [ "$health" = "none" ] && [ "$waited" -ge 20 ]; then
          ok "Контейнер запущен (healthcheck не настроен)."; return 0; fi
        ;;
      exited|dead)
        err "Контейнер $BOT_CONTAINER упал (state=$state). Последние логи:"
        DC logs --tail 40 "$BOT_CONTAINER" 2>/dev/null || true
        return 1
        ;;
    esac
    sleep 5; waited=$((waited+5))
    printf '\r  ...%ss (state=%s health=%s)   ' "$waited" "$state" "$health"
  done
  echo
  err "Не дождался статуса healthy за ${timeout}s."
  err "Вероятнее всего ещё идут миграции, либо healthcheck бота не отвечает."
  err "Продолжать нельзя: следующий шаг сделает 'docker compose down' и оборвёт их."
  DC logs --tail 40 "$BOT_CONTAINER" 2>/dev/null || true
  return 1
}

# ----------------------------------------------------------- один шаг апгрейда
upgrade_to() {
  local target="$1" ref prev
  ref="$(tag_ref "$target")"
  [ -n "$ref" ] || die "Не найден git-тег для версии $target"

  step "👉 ВЕРСИЯ: $target    ⏰ $(date '+%F %T')"

  if [ "$DRY_RUN" = "1" ]; then echo "  [dry-run] git checkout $ref + сборка образа + перезапуск"; return 0; fi

  check_disk    # перед каждой сборкой образа проверяем место
  prev="$(git rev-parse HEAD)"
  info "git checkout $ref"
  git checkout -q "$ref" || die "Не удалось переключиться на $ref (есть незакоммиченные правки в отслеживаемых файлах?)"

  # Образ собирается ДО остановки контейнеров. Сборка — самый ненадёжный шаг:
  # ей нужна сеть до реестра и до репозиториев пакетов, и отваливается она по
  # причинам, к обновлению отношения не имеющим. Раньше её провал наступал уже
  # после 'docker compose down' и оставлял бота лежать. Теперь до этого момента
  # старая версия продолжает работать, а неудачная сборка просто откатывает git.
  info "Собираю образ версии $target (контейнеры продолжают работать)..."
  if ! DC build; then
    warn "Сборка образа $target не удалась — возвращаю git на предыдущую версию."
    git checkout -q "$prev" || warn "Не удалось вернуть git на $prev — переключитесь вручную."
    die "Сборка $target не удалась. Бот не останавливался и работает на прежней версии."
  fi
  ok "Образ собран."

  info "Перезапускаю контейнеры (образ готов, миграции пойдут на старте бота)..."
  if make -n reload >/dev/null 2>&1; then
    make reload || die "make reload завершился ошибкой на $target"
  else
    DC up -d --build || die "docker compose up завершился ошибкой на $target"
  fi

  # Здесь откат уже НЕ автоматический: контейнер стартовал, значит миграции
  # версии $target могли примениться частично или полностью, и молча
  # переключать код назад на изменённую схему нельзя.
  if ! wait_healthy 900; then
    err "Автоматический откат не делается: миграции $target могли уже примениться."
    err "Вернуться на предыдущую версию вручную:"
    err "  cd \"$BOT_DIR\" && git checkout $prev && docker compose up -d"
    err "Если схема БД уже изменена — восстановите дамп (команда в конце вывода скрипта)."
    die "Контейнер не поднялся на версии $target. Обновление остановлено."
  fi
  ok "Версия $target установлена."
}

# --------------------------------------------------------------- обновление cabinet
update_cabinet() {
  local cab="${CABINET_DIR:-$(dirname "$BOT_DIR")/cabinet}"
  if [ ! -d "$cab" ]; then
    info "Папка cabinet не найдена рядом с ботом — пропускаю."
    return 0
  fi
  if [ ! -f "$cab/docker-compose.yml" ] && [ ! -f "$cab/docker-compose.yaml" ]; then
    warn "В $cab нет docker-compose — пропускаю обновление кабинета."
    return 0
  fi
  step "🖥  Обновляю Cabinet: $cab"
  if [ "$DRY_RUN" = "1" ]; then echo "  [dry-run] pull + down + up -d"; return 0; fi
  ( cd "$cab" && DC pull && DC down && DC up -d ) \
    && ok "Cabinet обновлён." \
    || warn "Не удалось обновить Cabinet — проверьте вручную в $cab"
}

# ==================================================================== патчи
# Патчи — это наши правки поведения бота, которых нет в апстриме.
#
# Ключевое ограничение: обновление делает `git checkout <тег>`, поэтому любая
# правка в отслеживаемых файлах бота либо потеряется, либо уронит обновление.
# Поэтому патчи не трогают git-дерево вообще:
#
#   $BOT_DIR/patches/                    — наш код (папка не отслеживается git:
#                                          .gitignore бота начинается с `*`)
#   $BOT_DIR/docker-compose.override.yml — монтирует patches/ в контейнер и
#                                          подменяет команду на bootstrap.py,
#                                          который подключает патчи и запускает
#                                          штатный main.py
#
# Оба пути git игнорирует, `git checkout` их не трогает, docker compose
# подхватывает override автоматически. Так что после обновления патчи остаются
# на месте сами; переустановка в конце нужна лишь для того, чтобы подтянуть
# свежие версии самих патчей.

PATCHES_BASE_URL="${PATCHES_BASE_URL:-https://raw.githubusercontent.com/kifchandr/bedolaga_updater/main/patches}"
PATCH_MARKER="# managed-by: bedolaga_updater patches"

patches_dir()     { echo "$BOT_DIR/patches"; }
override_file()   { echo "$BOT_DIR/docker-compose.override.yml"; }

patches_installed() {
  local ovr; ovr="$(override_file)"
  [ -f "$ovr" ] && grep -qF "$PATCH_MARKER" "$ovr" && [ -f "$(patches_dir)/bootstrap.py" ]
}

# Скачивает файлы патчей во временный каталог и подменяет ими папку patches/
# целиком. Целиком — чтобы модуль, удалённый из манифеста, не остался работать.
# patches.env (настройки администратора) переносится в новую папку как есть.
patches_fetch() {
  need_cmd curl
  local pdir stage rel
  pdir="$(patches_dir)"
  stage="$(mktemp -d "$BOT_DIR/.patches_stage.XXXXXX")" || { err "Не удалось создать временную папку."; return 1; }

  info "Скачиваю манифест патчей..."
  if ! curl -fsSL "$PATCHES_BASE_URL/manifest.txt" -o "$stage/manifest.txt"; then
    rm -rf "$stage"; err "Не удалось скачать $PATCHES_BASE_URL/manifest.txt"; return 1
  fi

  while IFS= read -r rel || [ -n "$rel" ]; do
    rel="${rel%$'\r'}"
    case "$rel" in ''|'#'*) continue;; esac
    # Манифест приходит по сети и раскладывает файлы по чужой машине.
    # Путь наружу каталога — либо ошибка, либо подмена; в обоих случаях стоп.
    case "$rel" in
      /*|*..*)
        rm -rf "$stage"
        err "Подозрительный путь в манифесте: '$rel'. Установка прервана."
        return 1
        ;;
    esac
    mkdir -p "$stage/$(dirname "$rel")"
    info "  ↓ $rel"
    if ! curl -fsSL "$PATCHES_BASE_URL/$rel" -o "$stage/$rel"; then
      rm -rf "$stage"; err "Не удалось скачать $rel — папка patches не тронута."; return 1
    fi
  done < "$stage/manifest.txt"

  # Настройки администратора переживают обновление патчей.
  [ -f "$pdir/patches.env" ] && cp -p "$pdir/patches.env" "$stage/patches.env"
  # Первая установка: заводим patches.env из примера.
  [ -f "$stage/patches.env" ] || cp "$stage/patches.env.example" "$stage/patches.env"

  # Старую папку сначала отодвигаем и только потом удаляем: если mv провалится,
  # рабочие патчи останутся на месте, а не исчезнут вместе с каталогом.
  local old=""
  if [ -d "$pdir" ]; then
    old="$pdir.old.$$"
    mv "$pdir" "$old" || { rm -rf "$stage"; err "Не удалось отодвинуть $pdir"; return 1; }
  fi
  if ! mv "$stage" "$pdir"; then
    err "Не удалось переместить $stage → $pdir"
    [ -n "$old" ] && mv "$old" "$pdir" && warn "Вернул прежнюю версию патчей."
    rm -rf "$stage"
    return 1
  fi
  [ -n "$old" ] && rm -rf "$old"
  # Внутри контейнера бот работает под uid 1000 и монтирует папку read-only.
  chmod -R a+rX "$pdir"
  patches_sync_switches
  ok "Файлы патчей обновлены: ${pdir#$BOT_DIR/}/"
}

# Список выключателей берём из patches.env: там он полный, потому что
# patches_sync_switches дописывает недостающие при каждом обновлении.
patches_switches() {
  local env; env="$(patches_dir)/patches.env"
  [ -f "$env" ] && grep -oE '^PATCH_[A-Z0-9_]+_ENABLED' "$env" | awk '!seen[$0]++'
}

patches_switch_state() {  # patches_switch_state KEY -> 1|0
  local env v; env="$(patches_dir)/patches.env"
  v=$(grep -E "^$1=" "$env" 2>/dev/null | tail -n1 | cut -d= -f2- | tr -d '[:space:]')
  case "$v" in 0|false|no|off|'') [ -z "$v" ] && echo 1 || echo 0 ;; *) echo 1 ;; esac
}

# Комментарий-описание — это строка над выключателем в patches.env.
patches_switch_label() {  # patches_switch_label KEY
  local env; env="$(patches_dir)/patches.env"
  awk -v key="$1" '
    /^#/ { last = substr($0, 2); sub(/^[ \t]+/, "", last); next }
    $0 ~ "^" key "=" { print last; found = 1; exit }
    { last = "" }
    END { if (!found) print "" }
  ' "$env" 2>/dev/null
}

# Новый патч в апстриме приносит новый выключатель. patches.env мы не
# перезаписываем (там настройки администратора), поэтому недостающие
# выключатели дописываем — иначе новый патч работал бы, но в меню его не было.
patches_sync_switches() {
  local pdir env example key added=0
  pdir="$(patches_dir)"; env="$pdir/patches.env"; example="$pdir/patches.env.example"
  [ -f "$env" ] && [ -f "$example" ] || return 0

  for key in $(grep -oE '^PATCH_[A-Z0-9_]+_ENABLED' "$example" | awk '!seen[$0]++'); do
    grep -qE "^[[:space:]]*$key=" "$env" && continue
    if [ "$added" -eq 0 ]; then
      printf '\n# --- Выключатели новых патчей, добавлены %s ---\n' "$(date +%F)" >> "$env"
      added=1
    fi
    printf '%s\n%s=1\n' "# $(awk -v k="$key" '/^#/ {l=substr($0,2); sub(/^[ \t]+/,"",l); next} $0 ~ "^" k "=" {print l; exit} {l=""}' "$example")" "$key" >> "$env"
    info "  + новый патч включён: $key"
  done
}

patches_print_switches() {
  local key state n=0
  for key in $(patches_switches); do
    n=$((n+1))
    state=$(patches_switch_state "$key")
    # Ширину не задаём через %-Ns: в printf она считается в байтах, а кириллица
    # занимает по два — колонки разъезжались бы. Выравниваем текстом.
    if [ "$state" = "1" ]; then
      printf '  %d) %s[вкл] %s %s\n'  "$n" "$C_GRN" "$C_RESET" "$(patches_switch_label "$key")"
    else
      printf '  %d) %s[выкл]%s %s\n' "$n" "$C_YEL" "$C_RESET" "$(patches_switch_label "$key")"
    fi
    printf '     %s\n' "$key"
  done
  [ "$n" -eq 0 ] && warn "В patches.env не найдено ни одного выключателя PATCH_*_ENABLED."
  return 0
}

patches_toggle_menu() {
  step "🧩 Патчи: включение / выключение"
  local env; env="$(patches_dir)/patches.env"
  if [ ! -f "$env" ]; then
    err "Нет $env — сначала установите патчи (пункт 1)."
    return 1
  fi

  local changed=0
  while :; do
    local keys=() items=() key state new choice=""
    while IFS= read -r key; do
      [ -n "$key" ] || continue
      keys+=("$key")
      # Пометку рисуем текстом, а не цветом: подсветка выбранного пункта —
      # это фон на всю строку, и вложенный сброс цвета рвал бы её посередине.
      if [ "$(patches_switch_state "$key")" = "1" ]; then
        items+=("[✓] $(patches_switch_label "$key")")
      else
        items+=("[ ] $(patches_switch_label "$key")")
      fi
    done < <(patches_switches)

    if [ "${#keys[@]}" -eq 0 ]; then
      warn "В patches.env не найдено ни одного выключателя PATCH_*_ENABLED."
      return 1
    fi
    items+=("Назад")

    echo
    echo "Enter переключает выбранный патч. По умолчанию включено всё."
    echo
    pick choice "${items[@]}"

    # Пусто (Esc/q) или последний пункт «Назад» — выходим.
    [ -z "$choice" ] && break
    [ "$choice" -gt "${#keys[@]}" ] && break

    key="${keys[$((choice - 1))]}"
    state=$(patches_switch_state "$key")
    [ "$state" = "1" ] && new=0 || new=1
    if grep -qE "^$key=" "$env"; then
      sed -i -E "s|^$key=.*|$key=$new|" "$env"
    else
      printf '%s=%s\n' "$key" "$new" >> "$env"
    fi
    changed=1
    [ "$new" = "1" ] && ok "$key включён" || ok "$key выключен"
  done

  [ "$changed" = "0" ] && { info "Ничего не изменено."; return 0; }

  if [ "$DRY_RUN" = "1" ]; then
    echo "  [dry-run] перезапуск пропущен"
    return 0
  fi
  if confirm "Перезапустить бота, чтобы изменения вступили в силу?"; then
    patches_restart || return 1
    patches_verify
  else
    warn "Пока бот не перезапущен, список патчей не изменился."
    info "Применить: cd \"$BOT_DIR\" && docker compose up -d --force-recreate $(bot_service)"
  fi
}

# Всё ли нужное уже есть в override. Если да — файл не трогаем: в него могли
# дописать своё (частый случай — build.network: host, без которого на хостах с
# нестандартным MTU не идёт сборка), и перегенерация это стёрла бы.
patches_override_ok() {
  local ovr; ovr="$(override_file)"
  [ -f "$ovr" ] || return 1
  grep -qF "$PATCH_MARKER" "$ovr" || return 1
  grep -qF './patches:/app/patches:ro' "$ovr" || return 1
  grep -qF '/app/patches/bootstrap.py' "$ovr" || return 1
}

# Блок, который патчам нужен внутри services.bot. Один источник и для
# генерируемого файла, и для подсказки по ручному слиянию — чтобы не разъехались.
patches_override_block() {
  cat <<'YAML'
    volumes:
      - ./patches:/app/patches:ro
    environment:
      BEDOLAGA_PATCHES: '1'
      BEDOLAGA_APP_DIR: /app
    command: ['python', '/app/patches/bootstrap.py']
YAML
}

patches_write_override() {
  local ovr; ovr="$(override_file)"

  if patches_override_ok; then
    ok "docker-compose.override.yml уже настроен — оставляю как есть."
    return 0
  fi

  if [ -f "$ovr" ] && ! grep -qF "$PATCH_MARKER" "$ovr"; then
    warn "В папке бота уже есть docker-compose.override.yml, созданный не этим скриптом."
    echo "Его содержимое:" >&2
    sed 's/^/   │ /' "$ovr" >&2
    echo >&2
    warn "Перезапись сотрёт всё, что в нём настроено, — а настроено там обычно то,"
    warn "без чего бот или сборка не работают на этом сервере."
    warn "Надёжнее слить руками: допишите в services.bot эти ключи,"
    warn "а первой строкой файла поставьте маркер — тогда скрипт файл не тронет:"
    {
      echo
      echo "   $PATCH_MARKER"
      echo "   services:"
      echo "     bot:"
      patches_override_block | sed 's/^/   /'
      echo
    } >&2
    confirm "Всё-таки перезаписать? (копия останется рядом с суффиксом .bak-<дата>)" n \
      || { err "Оставил ваш override нетронутым. Патчи не подключены."; return 1; }
  fi

  # Копию делаем перед любой перезаписью, в том числе своего же файла: в нём
  # могло оказаться дописанное вручную, а сюда мы попадаем как раз тогда,
  # когда содержимое не распозналось как целое.
  if [ -f "$ovr" ]; then
    local backup="$ovr.bak-$(date +%Y%m%d_%H%M%S)"
    cp -p "$ovr" "$backup" && info "Прежний файл сохранён: ${backup##*/}"
  fi

  {
    echo "$PATCH_MARKER"
    cat <<'YAML'
# Файл создан скриптом bedolaga_updater. Он подключает патчи из ./patches,
# не меняя ни одного файла бота.
#
# Дописывать сюда своё МОЖНО: пока в файле есть маркер выше и оба ключа патчей
# (монтирование ./patches и command на bootstrap.py), скрипт его не перезапишет.
# Убрать патчи:  bedolaga_updater patches  →  «Удалить патчи»
#
# BEDOLAGA_PATCHES=0 отключает патчи, не удаляя их (полезно для диагностики:
# так можно проверить, виноват ли патч в проблеме).
services:
  bot:
YAML
    patches_override_block
  } > "$ovr"
  ok "docker-compose.override.yml записан."
}

# Имя compose-сервиса бота. Обычно 'bot', но берём из label запущенного
# контейнера, чтобы переименование сервиса ничего не ломало.
bot_service() {
  local s
  s=$(docker inspect -f '{{ index .Config.Labels "com.docker.compose.service" }}' "$BOT_CONTAINER" 2>/dev/null)
  echo "${s:-bot}"
}

# Перезапуск с гарантией, что новый процесс подхватит свежие патчи.
#
# Одного `docker compose up -d` мало: patches/ и patches.env подключены
# bind-mount'ом, конфигурация compose при этом не меняется, и compose честно
# отвечает «up-to-date», оставляя работать старый процесс со старым кодом.
# Поэтому сервис бота пересоздаём принудительно. Зависимости (postgres, redis)
# поднимает первый up -d, а --no-deps во втором не даёт их пересоздать.
patches_restart() {
  local svc; svc="$(bot_service)"
  ( cd "$BOT_DIR" && DC up -d ) || { err "docker compose up завершился ошибкой."; return 1; }
  if ! ( cd "$BOT_DIR" && DC up -d --force-recreate --no-deps "$svc" ); then
    warn "Не удалось пересоздать сервис '$svc' — перезапускаю контейнер напрямую."
    docker restart "$BOT_CONTAINER" >/dev/null 2>&1 \
      || { err "Не удалось перезапустить $BOT_CONTAINER."; return 1; }
  fi
  wait_healthy 600 || { err "Контейнер не поднялся после перезапуска."; return 1; }
}

# Реестр патчей печатает при старте итоговую строку («подключены патчи…» либо
# «ни один патч не подключён»), а следом уточнения. Судим строго по последнему
# запуску: обычно контейнер пересоздан и лог чистый, но в запасном сценарии с
# `docker restart` в нём остаются прошлые запуски, и старая удачная строка
# выдала бы успех там, где свежий запуск упал.
patches_verify() {
  local logs block
  logs=$(docker logs --tail 2000 "$BOT_CONTAINER" 2>&1 || true)
  # Идём по строкам патчей с конца и останавливаемся на первой же итоговой —
  # получаем блок последнего запуска.
  block=$(echo "$logs" | grep -F '[bedolaga-patches]' \
          | tac | awk '{ print } /подключены патчи|ни один патч не подключён/ { exit }' | tac)

  if [ -z "$block" ]; then
    warn "В логах контейнера не видно ни одной строки [bedolaga-patches]."
    warn "Проверьте вручную: docker logs $BOT_CONTAINER | grep bedolaga-patches"
    return 1
  fi
  echo "$block" | sed 's/^/   /'

  if echo "$block" | grep -q 'упали при подключении'; then
    warn "Часть патчей упала при подключении — бот работает, но эти правки не применились."
    warn "Подробности с трейсбеком: docker logs $BOT_CONTAINER | grep -A20 bedolaga-patches"
    return 1
  fi
  if echo "$block" | grep -q 'подключены патчи'; then
    ok "Патчи подключены."
    return 0
  fi
  # Все патчи выключены — это осознанный выбор администратора, а не сбой.
  if echo "$block" | grep -q 'выключены настройкой'; then
    ok "Патчи на месте, но все выключены настройкой."
    return 0
  fi
  warn "Патчи загрузились с ошибкой — бот работает, но правки не применились."
  return 1
}

patches_apply() {
  step "🧩 Патчи: установка / обновление"
  if [ "$DRY_RUN" = "1" ]; then
    echo "  [dry-run] скачивание патчей, запись override и перезапуск пропущены"
    return 0
  fi
  patches_fetch          || return 1
  patches_write_override || return 1

  info "Перезапускаю бота с патчами..."
  patches_restart || return 1
  patches_verify
}

patches_remove() {
  step "🧹 Патчи: удаление"
  local ovr pdir; ovr="$(override_file)"; pdir="$(patches_dir)"

  if [ -f "$ovr" ] && grep -qF "$PATCH_MARKER" "$ovr"; then
    [ "$DRY_RUN" = "1" ] || rm -f "$ovr"
    ok "Удалён docker-compose.override.yml."
  else
    info "Нашего docker-compose.override.yml нет — удалять нечего."
  fi

  if [ -d "$pdir" ]; then
    if confirm "Удалить и папку patches? В ней лежит ваш patches.env с настройками." n; then
      [ "$DRY_RUN" = "1" ] || rm -rf "$pdir"
      ok "Папка patches удалена."
    else
      info "Папка patches оставлена. Без override она не подключается."
    fi
  fi

  info "Таблицы patch_connect_reminders* остаются в БД: боту они не мешают,"
  info "а при повторной установке патчей история отправок не потеряется."

  if [ "$DRY_RUN" != "1" ]; then
    info "Перезапускаю бота в штатной конфигурации..."
    if patches_restart; then
      ok "Бот работает без патчей."
    else
      warn "Проверьте состояние контейнера вручную."
    fi
  fi
}

patches_status() {
  step "🧩 Патчи: статус"
  local ovr pdir; ovr="$(override_file)"; pdir="$(patches_dir)"

  if patches_installed; then
    ok "Патчи установлены."
  else
    warn "Патчи не установлены."
  fi
  echo "  override : $([ -f "$ovr" ] && echo "$ovr" || echo '— нет')"
  echo "  папка    : $([ -d "$pdir" ] && echo "$pdir" || echo '— нет')"
  if [ -d "$pdir" ]; then
    echo "  файлы    :"
    ( cd "$pdir" && find . -name '*.py' -o -name 'patches.env' | sed 's|^\./|     |' | sort )
  fi
  if [ -f "$pdir/patches.env" ]; then
    echo "  патчи    :"
    patches_print_switches | sed 's/^/  /'
    echo "  настройки:"
    grep -E '^[A-Z0-9_]+=' "$pdir/patches.env" | grep -v '_ENABLED=' | sed 's/^/     /'
  fi
  if docker ps --format '{{.Names}}' | grep -qx "$BOT_CONTAINER"; then
    echo "  в логах  :"
    patches_verify || true
  else
    warn "Контейнер $BOT_CONTAINER не запущен — логи не смотрю."
  fi
}

patches_menu() {
  while :; do
    step "🧩 Патчи Bedolaga"
    if patches_installed; then
      echo "Текущее состояние: ${C_GRN}установлены${C_RESET}"
    else
      echo "Текущее состояние: ${C_YEL}не установлены${C_RESET}"
    fi
    echo
    local choice=""
    pick choice \
      "Установить / обновить патчи" \
      "Включить / выключить патчи" \
      "Показать статус" \
      "Удалить патчи" \
      "Назад"
    case "$choice" in
      1) patches_apply       || warn "Установка патчей завершилась с ошибкой." ;;
      2) patches_toggle_menu || warn "Не удалось изменить список патчей." ;;
      3) patches_status ;;
      4) patches_remove ;;
      5|'') return 0 ;;
      *) warn "Не понял ответ: $choice" ;;
    esac
  done
}

# ------------------------------------------------------------------ главное меню
# Возврат из функции = «обновляем бота»: дальше по файлу идёт обычный поток
# обновления. Выход из скрипта делается прямо здесь.
main_menu() {
  while :; do
    step "🤖 Bedolaga Bot"
    if patches_installed; then
      echo "Патчи: ${C_GRN}установлены${C_RESET}"
    else
      echo "Патчи: ${C_YEL}не установлены${C_RESET}"
    fi
    echo
    local choice=""
    pick choice "Обновить бота" "Управление патчами" "Выход"
    case "$choice" in
      1)   return 0 ;;
      2)   patches_menu ;;
      3|'') info "Выход."; exit 0 ;;
      *)   warn "Не понял ответ: $choice" ;;
    esac
  done
}

# =============================================================== основной поток
if [ "$MODE" = "patches" ]; then
  patches_menu
  exit 0
fi

if [ "$MODE" = "menu" ]; then
  # Спрашивать некого, когда скрипт запущен из cron или с NO_CONFIRM=1 —
  # в таком режиме поведение прежнее: сразу обновление.
  if [ "${NO_CONFIRM:-0}" = "1" ] || { [ ! -r /dev/tty ] && [ ! -t 0 ]; }; then
    info "Неинтерактивный запуск — меню пропускаю, обновляю бота."
  else
    main_menu
  fi
fi

step "🚀 Bedolaga Bot — поэтапное обновление"

info "Получаю свежие теги..."
[ "$DRY_RUN" = "1" ] || git fetch --tags --quiet || warn "git fetch не удался — работаю с локальными тегами."

CURRENT="$(current_version)"
[ -n "$CURRENT" ] || { ask "Не удалось определить текущую версию. Введите её вручную (напр. 3.46.1): " CURRENT; }
CURRENT="$(norm "$CURRENT")"
info "Текущая версия: ${C_BOLD}$CURRENT${C_RESET}"

# Полный отсортированный список стабильных версий
mapfile -t ALL < <(git tag | sed 's/^v//' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V)
[ "${#ALL[@]}" -gt 0 ] || die "Не найдено ни одного тега версии в репозитории."

LATEST="${TARGET_VERSION:-${ALL[-1]}}"
LATEST="$(norm "$LATEST")"
info "Целевая версия: ${C_BOLD}$LATEST${C_RESET}"

# Список версий строго больше текущей и не больше целевой
PENDING=()
for v in "${ALL[@]}"; do
  # v > CURRENT ?
  [ "$(printf '%s\n%s\n' "$CURRENT" "$v" | sort -V | tail -n1)" = "$v" ] && [ "$v" != "$CURRENT" ] || continue
  # v <= LATEST ?
  [ "$(printf '%s\n%s\n' "$v" "$LATEST" | sort -V | tail -n1)" = "$LATEST" ] || continue
  PENDING+=("$v")
done

# Проверяем параметры БД заранее (нужны для бэкапа)
ensure_db
# Проверяем свободное место до старта
check_disk

if [ "${#PENDING[@]}" -eq 0 ]; then
  ok "Бот уже на версии $CURRENT — обновлять нечего."
else
  echo
  info "Будут последовательно установлены версии:"
  printf '   ➜ %s\n' "${PENDING[@]}"
  echo
  if [ "${BACKUP_EVERY:-0}" -eq 1 ]; then
    info "Бэкап БД делается перед КАЖДОЙ версией + финальный → ${BACKUP_DIR#$BOT_DIR/}/"
  elif [ "${BACKUP_EVERY:-0}" -gt 1 ]; then
    info "Бэкап БД делается перед каждой ${BACKUP_EVERY}-й версией + финальный → ${BACKUP_DIR#$BOT_DIR/}/"
  else
    info "Бэкап БД делается один раз в начале и один в конце → ${BACKUP_DIR#$BOT_DIR/}/"
  fi
  info "Хранится последних дампов: ${BACKUP_RETENTION} (дамп до обновления помечен _keep и не ротируется)"
  confirm "Начать обновление ${CURRENT} → ${LATEST} (${#PENDING[@]} шаг(ов))?" \
    || die "Отменено пользователем."

  # Если поштучные бэкапы отключены (BACKUP_EVERY=0), обязательный дамп в начале
  # всё равно делаем: без него откатываться будет не на что.
  [ "${BACKUP_EVERY:-0}" -gt 0 ] || make_backup "pre_${CURRENT}_keep"

  i=0
  for v in "${PENDING[@]}"; do
    # Бэкап ДО установки версии: миграции необратимы, и откатываться нужно на
    # состояние перед конкретным шагом, а не на то, что было N версий назад.
    if [ "${BACKUP_EVERY:-0}" -gt 0 ] && [ $(( i % BACKUP_EVERY )) -eq 0 ]; then
      if [ "$i" -eq 0 ]; then make_backup "pre_${v}_keep"; else make_backup "pre_${v}"; fi
    fi
    upgrade_to "$v"
    i=$((i+1))
    [ "$DRY_RUN" = "1" ] || sleep 3
  done
  # Финальный бэкап на достигнутой версии
  make_backup "post_${LATEST}"
  ok "Бот обновлён до версии $LATEST"
fi

# ------------------------------------------------------- переустановка патчей
# Сами патчи обновление пережили: и patches/, и override лежат вне git-дерева.
# Здесь мы лишь подтягиваем их свежие версии — на случай, если новая версия
# бота потребовала правок в самих патчах.
PATCHES_FAILED=0
case "$PATCHES" in
  0)
    if patches_installed; then
      warn "Патчи установлены, но переустановку пропускаю (--no-patches)."
      warn "Работать они продолжают — на боте сейчас их прежняя версия."
    fi
    ;;
  1)
    patches_apply || PATCHES_FAILED=1
    ;;
  *)  # auto
    if patches_installed; then
      info "Обнаружены установленные патчи — обновляю их под новую версию бота."
      patches_apply || PATCHES_FAILED=1
    else
      info "Патчи не установлены — пропускаю. Поставить: bedolaga_updater patches"
    fi
    ;;
esac
if [ "$PATCHES_FAILED" = "1" ]; then
  warn "Патчи переустановить не удалось. Бот обновлён и работает;"
  warn "разберитесь с патчами отдельно: bedolaga_updater patches"
fi

# Cabinet обновляем, когда бот доведён до последней версии
if [ "$LATEST" = "${ALL[-1]}" ]; then
  update_cabinet
else
  info "Целевая версия ($LATEST) не последняя — Cabinet не трогаю."
fi

# --------------------------------------------------- чистка неиспользуемых образов
if [ "$PRUNE_IMAGES" = "1" ] && [ "$DRY_RUN" != "1" ]; then
  step "🧹 Чистка неиспользуемых docker-образов"
  before=$(docker system df --format '{{.Type}} {{.Reclaimable}}' 2>/dev/null | awk '/Images/{print $2$3}')
  docker image prune -f >/dev/null 2>&1 && ok "Висячие (dangling) образы удалены." \
    || warn "Не удалось выполнить docker image prune."
  [ -n "${before:-}" ] && info "Освобождаемое место до чистки (образы): ${before}"
  info "Для более глубокой очистки вручную: docker system prune -af (удалит ВСЕ неиспользуемые образы)."
fi

# ------------------------------------------------------------------ финал
step "🎉 Готово"
cat <<EOF

Просмотр логов бота в реальном времени:

  ${C_BOLD}cd "$BOT_DIR" && docker compose logs -f${C_RESET}

Только логи контейнера бота:

  cd "$BOT_DIR" && docker compose logs -f $BOT_CONTAINER

Бэкапы БД лежат здесь:

  $BACKUP_DIR/

Восстановить БД из бэкапа при необходимости:

  cat "$BACKUP_DIR/<файл>.dump" | docker exec -i $PG_CONTAINER \\
      pg_restore -U $PG_USER -d $PG_DB --clean --if-exists

EOF

if patches_installed; then
  cat <<EOF
Патчи установлены. Их настройки:

  ${C_BOLD}$BOT_DIR/patches/patches.env${C_RESET}

После правки настроек перезапустите бота:

  cd "$BOT_DIR" && docker compose up -d

Логи патчей:

  docker logs $BOT_CONTAINER | grep bedolaga-patches

Управление патчами (установить/статус/удалить):

  curl -fsSL https://raw.githubusercontent.com/kifchandr/bedolaga_updater/main/bedolaga_updater | bash -s -- patches

EOF
fi
